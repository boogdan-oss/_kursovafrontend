# Куди Vite проксіює /api, /ws, /docs у npm run dev. За замовчуванням — локальний бекенд.
VITE_API_PROXY_TARGET=http://localhost:8000
# false вимикає MSW-заглушки для ендпоінтів, яких ще немає на бекенді.
VITE_ENABLE_MSW=true
# Адреса бекенду в проді (на Vercel: https://upars.duckdns.org). Порожньо — відносні шляхи через проксі.
VITE_API_URL=
# Адреса WebSocket у проді, напр. wss://upars.duckdns.org/ws/market. У dev береться з проксі Vite,
# а без неї й без VITE_API_URL live-оновлення вимкнені (Vercel не проксіює WebSocket).
VITE_WS_URL=
# OAuth Client ID з Google Cloud Console (тип Web application) для кнопки «Продовжити з Google».
# Той самий ID і секрет мають бути в .env бекенду. Порожньо — кнопка неактивна.
VITE_GOOGLE_CLIENT_ID=
