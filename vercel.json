{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://92.5.147.143:8000/api/:path*" },
    { "source": "/((?!api/|ws/|docs|openapi\\.json).*)", "destination": "/index.html" }
  ]
}
